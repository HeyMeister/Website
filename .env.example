# --- Site behaviour -----------------------------------------------------------
# "validation" = single landing page (Dec 2026 – Jan 2027), "full" = all pages.
SITE_MODE=validation
# Keep "false" until public communication is approved. When "true", the build
# fails if content/legal.ts still contains [PLACEHOLDERS].
PUBLIC_LAUNCH=false
# Optional HTTP Basic Auth for previews. Off by default: it is only active when
# PREVIEW_AUTH is exactly "true" AND PREVIEW_PASSWORD is set. User name is ignored.
# PREVIEW_AUTH=true
# PREVIEW_PASSWORD=

# --- Lead form ----------------------------------------------------------------
# Partner programme (/partner): "Partner werden" and "Tipp einreichen" go to this address.
PARTNER_INBOX=
RESEND_API_KEY=
# Recipient of lead and application emails.
CONTACT_EMAIL=
# Sender address on a domain verified in Resend, e.g. "HeyMeister Website <website@example.de>".
RESEND_FROM=
# Optional CRM webhook. Requests are signed with HMAC-SHA256 (header X-HeyMeister-Signature).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Booking ------------------------------------------------------------------
# e.g. https://cal.com/heymeister/erstgespraech — embed loads only after a click.
BOOKING_URL=

# --- Analytics (cookieless) ---------------------------------------------------
# Plausible site domain. Empty = no analytics. Script and events are proxied
# through this site, so the browser makes no third-party request.
ANALYTICS_DOMAIN=
# Plausible instance, change only when self-hosting.
ANALYTICS_HOST=https://plausible.io

# --- Investor data room (Supabase, region Frankfurt) -------------------------
# Project → Settings → API. Publishable key (or legacy anon key) is public by design;
# the secret key (or legacy service_role key) must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Rate limiting (lead form, data-room login) ------------------------------------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
# Optional Upstash Redis (REST). Without it an in-memory limiter is used (per instance).
RATE_LIMIT_UPSTASH_URL=
RATE_LIMIT_UPSTASH_TOKEN=
